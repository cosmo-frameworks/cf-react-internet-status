{
  "name": "cf-react-internet-status",
  "version": "1.2.0",
  "description": "SSR-safe React hook, context provider and component for online/offline detection.",
  "keywords": [
    "react",
    "hooks",
    "offline",
    "online",
    "internet",
    "connectivity",
    "network",
    "navigator.onLine",
    "ssr",
    "typescript"
  ],
  "license": "MIT",
  "author": "Ridel Saavedra Flores",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cosmo-frameworks/cf-react-internet-status.git"
  },
  "homepage": "https://github.com/cosmo-frameworks/cf-react-internet-status#readme",
  "bugs": {
    "url": "https://github.com/cosmo-frameworks/cf-react-internet-status/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "size": "size-limit",
    "check:exports": "publint && attw --pack .",
    "prepublishOnly": "npm run build",
    "release": "changeset publish"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "size-limit": [
    {
      "name": "esm",
      "path": "dist/index.mjs",
      "limit": "3 KB"
    },
    {
      "name": "cjs",
      "path": "dist/index.cjs",
      "limit": "3.5 KB"
    }
  ],
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.17.4",
    "@changesets/cli": "^2.28.1",
    "@eslint/js": "^9.22.0",
    "@size-limit/preset-small-lib": "^11.2.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitest/coverage-v8": "^3.0.8",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.5.3",
    "publint": "^0.3.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "size-limit": "^11.2.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vitest": "^3.0.8"
  }
}
